# Copy this file to backend/.env (or export these as real environment
# variables) to enable LIVE processing. Demo mode works with none of this set.
#
# Never commit a real .env file or paste a real key into chat/commits.

# Required for live mode. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional - defaults to claude-sonnet-5-5 (current-generation Sonnet; a good
# balance of extraction quality and cost for this workload). Any valid
# Anthropic model ID that supports PDF document input can be used instead.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional server tuning (sane local defaults are built in; override only if needed).
# HOST=127.0.0.1
# PORT=8000
# MAX_UPLOAD_MB=25
# MAX_PAGE_COUNT=100
# MAX_PAGES_PER_BATCH=5
# MAX_PAGES_PER_JOB=20
# JOB_MAX_RETRIES=2
# STORAGE_DIR=/absolute/path/to/storage
# DB_PATH=/absolute/path/to/aviation_records.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Access gate - REQUIRED before deploying anywhere beyond localhost.
# ---------------------------------------------------------------------------
# This app ships with no per-user accounts. ADMIN_PASSWORD turns on a single
# shared-password gate in front of the whole app (login screen + session
# cookie) - see README "Deploying beyond localhost" before relying on this
# for anything more than keeping casual visitors out. Leave unset for local
# demo use; REQUIRED if the server is reachable from the public internet.
ADMIN_PASSWORD=

# Signs the session cookie. Required if you run more than one worker
# process (e.g. `uvicorn --workers N`) or want sessions to survive a
# restart; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Whether the session cookie requires HTTPS. Auto-detected (on unless HOST
# is 127.0.0.1/localhost) - only set this if that default is wrong for your
# setup, e.g. a reverse proxy terminates TLS in front of this process.
# COOKIE_SECURE=true
