# Copy this file to backend/.env (or export these as real environment
# variables) to enable LIVE processing. Demo mode works with none of this set.
#
# Never commit a real .env file or paste a real key into chat/commits.

# Required for live mode. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional - defaults to claude-sonnet-5-5 (current-generation Sonnet; a good
# balance of extraction quality and cost for this workload). Any valid
# Anthropic model ID that supports PDF document input can be used instead.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional server tuning (sane local defaults are built in; override only if needed).
# HOST=127.0.0.1
# PORT=8000
# MAX_UPLOAD_MB=25
# MAX_PAGE_COUNT=100
# MAX_PAGES_PER_BATCH=5
# MAX_PAGES_PER_JOB=20
# JOB_MAX_RETRIES=2
# STORAGE_DIR=/absolute/path/to/storage
# DB_PATH=/absolute/path/to/aviation_records.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
